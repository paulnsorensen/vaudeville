{
  "description": "Vaudeville semantic enforcement hooks — SLM-powered quality gates",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/session-start.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\" python \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/runner.py\" --harness codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
